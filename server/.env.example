# ── LifeSaver — server environment ───────────────────────────────────────────
# Copy to `.env` and fill in. Never commit the filled-in file (.gitignore
# already excludes server/.env).
#
# Every variable below is read by the code. If a variable isn't listed here,
# the server doesn't use it.

# ── LLM providers ────────────────────────────────────────────────────────────
# At least ONE of these is required — it backs the shared quota that users fall
# back to before adding a personal key in the app. Groq is the default provider.
GROQ_API_KEY=            # console.groq.com/keys  (default — fast, free tier)
GEMINI_API_KEY=          # aistudio.google.com/app/apikey  (fallback provider)

# ── Google Calendar OAuth ────────────────────────────────────────────────────
# Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client (Web).
# The redirect URI must match one registered on that client exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/calendar/callback

# ── Firebase Admin SDK ───────────────────────────────────────────────────────
# Firebase Console → Project Settings → Service Accounts → Generate new private
# key. Take these three values from the downloaded JSON.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep the surrounding quotes and the literal \n escapes exactly as they appear
# in the JSON, e.g. "-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
FIREBASE_PRIVATE_KEY=""

# ── Secrets encryption ───────────────────────────────────────────────────────
# Encrypts users' own provider API keys before they are written to Firestore.
# Optional: if unset, the key is derived from FIREBASE_PRIVATE_KEY, so encryption
# is on by default. Set it explicitly to rotate independently of the Firebase
# service account — note that changing either value makes already-stored API keys
# unreadable, and affected users must re-enter theirs.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRETS_KEY=

# ── External cron ────────────────────────────────────────────────────────────
# Shared secret for POST /api/cron/progress and POST /api/cron/briefing, sent by
# the caller as an `X-Cron-Secret` header. Needed on hosts that sleep when idle
# (Render's free tier), where the in-process node-cron timers never fire.
# Leave blank to keep those endpoints disabled — blank means OFF, never "open".
# Generate with:  node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=

# ── Server ───────────────────────────────────────────────────────────────────
PORT=5000
CLIENT_URL=http://localhost:5173  # CORS origin + OAuth redirect target
